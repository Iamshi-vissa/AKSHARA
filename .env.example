# AKSHARA configuration. Copy to `.env` (docker compose) or `backend/.env` (local dev).
# Never commit real secrets. Generate the JWT secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

AKSHARA_ENVIRONMENT=development          # development | test | production
AKSHARA_LOG_LEVEL=INFO

# --- Required secrets ---------------------------------------------------------------------
AKSHARA_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
POSTGRES_PASSWORD=change-me

# --- Services (docker compose sets these for you) -------------------------------------------
AKSHARA_DATABASE_URL=postgresql+asyncpg://akshara:change-me@localhost:5432/akshara
AKSHARA_REDIS_URL=redis://localhost:6379/0

# --- Security -------------------------------------------------------------------------------
AKSHARA_COOKIE_SECURE=false              # MUST be true behind HTTPS in production
AKSHARA_ACCESS_TOKEN_TTL_SECONDS=900
AKSHARA_REFRESH_TOKEN_TTL_SECONDS=1209600
AKSHARA_LOGIN_RATE_LIMIT_PER_MINUTE=10
AKSHARA_RATE_LIMIT_BACKEND=redis         # redis | memory (single process only)

# --- Storage --------------------------------------------------------------------------------
AKSHARA_STORAGE_BACKEND=local
AKSHARA_STORAGE_ROOT=./var/blobs

# --- Upload limits (decision D15) -------------------------------------------------------------
AKSHARA_MAX_UPLOAD_BYTES=52428800
AKSHARA_MAX_OOXML_UNCOMPRESSED_BYTES=209715200
AKSHARA_MAX_OOXML_ENTRIES=10000
AKSHARA_MAX_COMPRESSION_RATIO=100
